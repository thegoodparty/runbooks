{
  "$schema": "../_schema/manifest.schema.json",
  "id": "opposition_research",
  "version": 1,
  "model": "sonnet",
  "max_turns": 80,
  "timeout_seconds": 1200,
  "runtime": {
    "max_parallel_subagents": 20,
    "max_thinking_tokens": 0
  },
  "input_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Opposition Research input params",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "race_id",
      "user_email",
      "user_full_name",
      "campaign_strategy_context"
    ],
    "properties": {
      "race_id": {
        "type": "string",
        "minLength": 1,
        "description": "BallotReady brHashId. Trace / idempotency identifier only — the agent does NOT reason over it or look anything up with it."
      },
      "user_email": {
        "type": "string",
        "description": "The candidate's email. Used to mark is_user against the roster (exact match, case-insensitive + trimmed)."
      },
      "user_first_name": { "type": ["string", "null"] },
      "user_last_name": { "type": ["string", "null"] },
      "user_full_name": {
        "type": "string",
        "minLength": 1,
        "description": "The candidate we write FOR. Referred to as 'you' in output, never by name. Fallback for is_user when the email doesn't match a roster row."
      },
      "user_party_affiliation": {
        "type": ["string", "null"],
        "description": "Party label, or null. 'Other' means the real value is in other_party."
      },
      "other_party": {
        "type": ["string", "null"],
        "description": "The candidate's party when user_party_affiliation == 'Other'."
      },
      "campaign_strategy_context_status": {
        "type": ["string", "null"],
        "description": "gp-api's fetch status for the context (e.g. 'ok'). Informational; the agent ignores it."
      },
      "campaign_strategy_context": {
        "type": "object",
        "additionalProperties": false,
        "description": "The election-api campaign-strategy-context result, hydrated by gp-api before dispatch. The agent does NOT call election-api; this is its only roster source besides web search.",
        "required": ["candidate_count", "candidate_office", "candidates"],
        "properties": {
          "candidate_count": { "type": "integer" },
          "candidate_office": { "type": ["string", "null"] },
          "candidates": {
            "type": "array",
            "description": "Full seed roster (NOT pre-filtered). The agent marks the candidate via is_user and excludes them; it does not receive a pre-trimmed opponent list.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["first_name", "last_name", "full_name"],
              "properties": {
                "gp_candidate_id": { "type": ["string", "null"] },
                "first_name": { "type": "string" },
                "last_name": { "type": "string" },
                "full_name": { "type": "string" },
                "email": { "type": ["string", "null"] },
                "website_url": { "type": ["string", "null"] },
                "party": { "type": ["string", "null"] },
                "is_incumbent": { "type": ["boolean", "null"] }
              }
            }
          },
          "civics_win_number": { "type": ["integer", "null"] },
          "contacts_needed_estimate": { "type": ["integer", "null"] },
          "filing_date_end": { "type": ["string", "null"] },
          "general_election_date": { "type": ["string", "null"] },
          "number_of_seats": { "type": ["integer", "null"] },
          "office_level": { "type": ["string", "null"] },
          "office_type": { "type": ["string", "null"] },
          "official_office_name": { "type": ["string", "null"] },
          "partisanType": {
            "type": ["string", "null"],
            "description": "Race partisan type from election-api (e.g. 'partisan' / 'nonpartisan'). 'nonpartisan' means the party labels are voter-registration noise, not the contest. May be null until election-api populates it. Not enum-constrained — election-api is the source of truth for the value."
          },
          "primary_election_date": { "type": ["string", "null"] },
          "projected_turnout": { "type": ["integer", "null"] },
          "relevant_election_date": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "win_number_effective": { "type": ["integer", "null"] },
          "win_number_estimate": { "type": ["integer", "null"] },
          "projected_voter_turnout": { "type": ["integer", "null"] },
          "registered_voters": { "type": ["integer", "null"] },
          "unique_cellphones": { "type": ["integer", "null"] },
          "unique_landlines": { "type": ["integer", "null"] }
        }
      }
    }
  },
  "output_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Opposition Research artifact",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "markdown",
      "opponents",
      "race",
      "generated_at"
    ],
    "properties": {
      "markdown": {
        "type": "string",
        "minLength": 1,
        "description": "The exact '### Opposition Research' section per the runbook step-6 spec. No preamble, no closing summary."
      },
      "opponents": {
        "type": "array",
        "description": "Per-opponent structured research, one entry per researched opponent.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "full_name",
            "incumbent",
            "summary",
            "facts",
            "websites",
            "no_info"
          ],
          "properties": {
            "full_name": {
              "type": "string",
              "minLength": 1
            },
            "incumbent": {
              "type": "string",
              "enum": [
                "Yes",
                "No",
                "Unknown"
              ]
            },
            "summary": {
              "type": [
                "string",
                "null"
              ],
              "description": "2-3 sentence profile grounded in verified sources, or null when no_info is true."
            },
            "facts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "source_label",
                  "url"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://",
                    "description": "Must have returned HTTP 200 via pmf_runtime.http.get."
                  }
                }
              }
            },
            "websites": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^https?://"
              }
            },
            "no_info": {
              "type": "boolean",
              "description": "True when nothing was found beyond the name."
            }
          }
        }
      },
      "race": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "office_name",
          "state",
          "partisanType",
          "opponent_count"
        ],
        "properties": {
          "office_name": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "partisanType": {
            "type": [
              "string",
              "null"
            ]
          },
          "opponent_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of researched opponents (excludes cross-primary candidates and the candidate themselves)."
          }
        }
      },
      "generated_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  }
}
